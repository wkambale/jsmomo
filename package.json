{
  "name": "js-momo-sdk",
  "version": "1.2.1",
  "description": "JS MoMo SDK: Strictly typed TypeScript/JavaScript SDK for African mobile money and payment APIs (MTN MoMo, Airtel Money, Wave, Safaricom M-Pesa, Paystack, Flutterwave, Orange Money)",
  "keywords": [
    "mtn",
    "momo",
    "airtel",
    "wave",
    "mpesa",
    "daraja",
    "paystack",
    "flutterwave",
    "orange-money",
    "mobile-money",
    "africa",
    "fintech",
    "payments",
    "typescript",
    "sdk"
  ],
  "homepage": "https://wkambale.github.io/jsmomo/",
  "bugs": {
    "url": "https://github.com/wkambale/jsmomo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkambale/jsmomo.git"
  },
  "license": "MIT",
  "author": "Wesley Kambale",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "js-momo-sdk": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.16.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
